{
  "name": "@opencode/mobile",
  "version": "0.4.15",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.2"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "check": "bun run format && bun run lint:fix && bun run typecheck && expo install --check && bunx expo-doctor --verbose",
    "prebuild": "bun run vendor:xterm && expo prebuild --platform android",
    "expo:prebuild": "expo prebuild --platform android",
    "android": "expo run:android",
    "android:install": "expo run:android --variant release",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version-parity.mjs",
    "vendor:xterm": "node scripts/vendor-xterm.mjs",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.3.6",
    "marked": "18.0.14",
    "posthog-react-native": "^4.78.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-marked": "8.3.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    }
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
