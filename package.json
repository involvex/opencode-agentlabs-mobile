{
  "name": "@opencode-ai/mobile",
  "version": "0.4.13",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "check": "bun run format && bun run lint:fix && bun run typecheck && expo install --check && bunx expo-doctor --verbose",
    "expo:prebuild": "expo prebuild --platform android",
    "android": "expo run:android",
    "android:install": "expo run:android --variant release",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version-parity.mjs",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-speech-recognition": "3.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.3.6",
    "posthog-react-native": "^4.57.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "8.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    }
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
